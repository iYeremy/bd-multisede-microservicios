# config/local.env.example
# conexion a las 6 instancias locales (scripts/instancias_locales.sh).
# copiar como config/local.env (git lo ignora). no lleva contrasenas:
# las instancias locales entran sin clave.

# base a la que se conecta para crear y borrar las bases del proyecto
ADMIN_DB=postgres
SSLMODE=disable
# true si no eres superusuario (como en neon); ajusta algunos permisos
NO_SUPERUSUARIO=false

CATALOGO_HOST=localhost
CATALOGO_PORT=5441
CATALOGO_USER=postgres
CATALOGO_PASSWORD=

IDENTIDAD_HOST=localhost
IDENTIDAD_PORT=5442
IDENTIDAD_USER=postgres
IDENTIDAD_PASSWORD=

COMPRAS_HOST=localhost
COMPRAS_PORT=5443
COMPRAS_USER=postgres
COMPRAS_PASSWORD=

INVENTARIOS_HOST=localhost
INVENTARIOS_PORT=5444
INVENTARIOS_USER=postgres
INVENTARIOS_PASSWORD=

VENTAS_HOST=localhost
VENTAS_PORT=5445
VENTAS_USER=postgres
VENTAS_PASSWORD=

REPORTES_HOST=localhost
REPORTES_PORT=5446
REPORTES_USER=postgres
REPORTES_PASSWORD=

# ---------------------------------------------------------------------
# backend (go)
# clave compartida para las llamadas entre servicios (rutas /interno).
# en neon/produccion: un valor largo al azar (openssl rand -hex 32).
TOKEN_INTERNO=desarrollo-local-no-usar-en-produccion
# puerto del gateway (la unica puerta publica). en local 8080; en la vm, 80
PUERTO_GATEWAY=8080
# cada cuantos minutos el servicio de reportes refresca las vistas (0 = nunca)
REFRESCO_MINUTOS=5
# clave del usuario tecnico svc_<servicio> de cada instancia.
# en local van vacias: las instancias locales entran sin clave.
SVC_CATALOGO_PASSWORD=
SVC_IDENTIDAD_PASSWORD=
SVC_COMPRAS_PASSWORD=
SVC_INVENTARIOS_PASSWORD=
SVC_VENTAS_PASSWORD=
SVC_REPORTES_PASSWORD=
