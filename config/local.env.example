# config/local.env.example
# conexion a las 6 instancias locales (scripts/instancias_locales.sh).
# copiar como config/local.env (git lo ignora). no lleva contrasenas:
# las instancias locales entran sin clave.

# base a la que se conecta para crear y borrar las bases del proyecto
ADMIN_DB=postgres
SSLMODE=disable
# true si no eres superusuario (como en neon); ajusta algunos permisos
NO_SUPERUSUARIO=false

CATALOGO_HOST=localhost
CATALOGO_PORT=5441
CATALOGO_USER=postgres
CATALOGO_PASSWORD=

IDENTIDAD_HOST=localhost
IDENTIDAD_PORT=5442
IDENTIDAD_USER=postgres
IDENTIDAD_PASSWORD=

COMPRAS_HOST=localhost
COMPRAS_PORT=5443
COMPRAS_USER=postgres
COMPRAS_PASSWORD=

INVENTARIOS_HOST=localhost
INVENTARIOS_PORT=5444
INVENTARIOS_USER=postgres
INVENTARIOS_PASSWORD=

VENTAS_HOST=localhost
VENTAS_PORT=5445
VENTAS_USER=postgres
VENTAS_PASSWORD=

REPORTES_HOST=localhost
REPORTES_PORT=5446
REPORTES_USER=postgres
REPORTES_PASSWORD=
