# config/docker.env.example
# configuracion para correr TODO en docker (docker-compose.yml): las 6
# instancias de postgresql y el backend. copiar como config/docker.env.
# la usan los contenedores de postgres, el init y los servicios de go.
#
# dentro de la red de docker cada contenedor se llama por su nombre
# (db-catalogo, db-ventas...) y todos escuchan en el puerto normal, 5432.

# clave del superusuario postgres de las 6 instancias (la lee la imagen de postgres)
POSTGRES_PASSWORD=cambia-esta-clave

ADMIN_DB=postgres
SSLMODE=disable
NO_SUPERUSUARIO=false

CATALOGO_HOST=db-catalogo
CATALOGO_PORT=5432
CATALOGO_USER=postgres
CATALOGO_PASSWORD=cambia-esta-clave

IDENTIDAD_HOST=db-identidad
IDENTIDAD_PORT=5432
IDENTIDAD_USER=postgres
IDENTIDAD_PASSWORD=cambia-esta-clave

COMPRAS_HOST=db-compras
COMPRAS_PORT=5432
COMPRAS_USER=postgres
COMPRAS_PASSWORD=cambia-esta-clave

INVENTARIOS_HOST=db-inventarios
INVENTARIOS_PORT=5432
INVENTARIOS_USER=postgres
INVENTARIOS_PASSWORD=cambia-esta-clave

VENTAS_HOST=db-ventas
VENTAS_PORT=5432
VENTAS_USER=postgres
VENTAS_PASSWORD=cambia-esta-clave

REPORTES_HOST=db-reportes
REPORTES_PORT=5432
REPORTES_USER=postgres
REPORTES_PASSWORD=cambia-esta-clave

# ---------------------------------------------------------------------
# backend (go)
TOKEN_INTERNO=cambia-este-token
PUERTO_GATEWAY=8080
REFRESCO_MINUTOS=5
# en docker si hacen falta: la red entre contenedores pide clave.
# las claves de este archivo van sin comillas ni espacios (los scripts lo
# cargan con "." y una comilla lo rompe)
SVC_CATALOGO_PASSWORD=clave-svc-catalogo
SVC_IDENTIDAD_PASSWORD=clave-svc-identidad
SVC_COMPRAS_PASSWORD=clave-svc-compras
SVC_INVENTARIOS_PASSWORD=clave-svc-inventarios
SVC_VENTAS_PASSWORD=clave-svc-ventas
SVC_REPORTES_PASSWORD=clave-svc-reportes
# donde esta cada servicio: en docker, por el nombre del contenedor
URL_CATALOGO=http://catalogo:8101
URL_IDENTIDAD=http://identidad:8102
URL_COMPRAS=http://compras:8103
URL_INVENTARIOS=http://inventarios:8104
URL_VENTAS=http://ventas:8105
URL_REPORTES=http://reportes:8106
