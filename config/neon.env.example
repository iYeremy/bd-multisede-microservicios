# config/neon.env.example
# conexion a los 6 proyectos de neon (uno por microservicio).
# copiar como config/neon.env (git lo ignora) y llenar con los datos de
# cada proyecto: neon console > el proyecto > connect. NUNCA subir el
# archivo con las contrasenas.

ADMIN_DB=neondb
SSLMODE=require
NO_SUPERUSUARIO=true

# proyecto andina-catalogo
CATALOGO_HOST=ep-xxxx-xxxx.REGION.aws.neon.tech
CATALOGO_PORT=5432
CATALOGO_USER=neondb_owner
CATALOGO_PASSWORD=

# proyecto andina-identidad
IDENTIDAD_HOST=ep-xxxx-xxxx.REGION.aws.neon.tech
IDENTIDAD_PORT=5432
IDENTIDAD_USER=neondb_owner
IDENTIDAD_PASSWORD=

# proyecto andina-compras
COMPRAS_HOST=ep-xxxx-xxxx.REGION.aws.neon.tech
COMPRAS_PORT=5432
COMPRAS_USER=neondb_owner
COMPRAS_PASSWORD=

# proyecto andina-inventarios
INVENTARIOS_HOST=ep-xxxx-xxxx.REGION.aws.neon.tech
INVENTARIOS_PORT=5432
INVENTARIOS_USER=neondb_owner
INVENTARIOS_PASSWORD=

# proyecto andina-ventas
VENTAS_HOST=ep-xxxx-xxxx.REGION.aws.neon.tech
VENTAS_PORT=5432
VENTAS_USER=neondb_owner
VENTAS_PASSWORD=

# proyecto andina-reportes
REPORTES_HOST=ep-xxxx-xxxx.REGION.aws.neon.tech
REPORTES_PORT=5432
REPORTES_USER=neondb_owner
REPORTES_PASSWORD=
